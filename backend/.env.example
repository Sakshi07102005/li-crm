# Application
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/li_crm
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=li_crm
DB_SSL=false

# Authentication & JWT
JWT_ACCESS_SECRET=super-secret-jwt-key-for-licrm-development-only-replace-in-production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

# Rate Limiting
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Seed accounts (Development only)
SEED_ADMIN_EMAIL=admin@licrm.example
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SAMPLE_PASSWORD=Sample@12345
