# Copy this file to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=li_crm
DB_SSL=false

# Seed accounts (development only; use strong, different values for any deployed environment)
SEED_ADMIN_EMAIL=admin@licrm.example
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SAMPLE_PASSWORD=Sample@12345


# Scheduler – enable/disable background jobs
SCHEDULER_ENABLED=true

# How many minutes before a follow‑up is considered overdue and a reminder is sent
REMINDER_MINUTES=15

# Path to the Firebase service‑account JSON file (optional, leave blank if not used)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
